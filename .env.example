# ── LLM providers ────────────────────────────────────────────────────────────
# Primary: MiniMax-M2 via the international endpoint (https://api.minimax.io).
MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimax.io/v1   # default; China: https://api.minimaxi.com/v1

# Fallbacks (skipped automatically when empty).
# Gemini free key: https://aistudio.google.com/apikey (free tier ≈ 20 requests/day)
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ── Model chain (optional) ───────────────────────────────────────────────────
# LiteLLM model strings, best first. Providers without credentials are skipped;
# providers that fail hard (auth/billing/missing model/daily quota) or keep
# rate-limiting are dropped for the rest of the run. Ollama is local-only and
# is skipped on CI unless OLLAMA_API_BASE is set.
LLM_CHAIN=minimax/MiniMax-M2,gemini/gemini-2.5-flash,mistral/mistral-small-latest,ollama/qwen2.5

# ── Summarization tuning (optional) ──────────────────────────────────────────
# Max characters of article text sent to the LLM per article.
MAX_INPUT_CHARS=6000
# Cap on articles summarized per run (0 = no cap). Newest first.
MAX_ARTICLES_PER_RUN=0
# Articles per LLM request (1 = one request per article).
SUMMARY_BATCH_SIZE=5
# Parallel LLM requests.
LLM_CONCURRENCY=3
# Stop retrying an article after N failed attempts, or once it is older than
# N days; such articles are still shown on the site by their feed title.
SUMMARY_MAX_ATTEMPTS=3
SUMMARY_MAX_AGE_DAYS=7

# ── Paths ─────────────────────────────────────────────────────────────────────
DB_PATH=news.db
SITE_DIR=site
SITE_TITLE=Daily Global-Macro Brief
