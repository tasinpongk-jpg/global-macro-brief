# ── LLM providers ────────────────────────────────────────────────────────────
# Primary. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallbacks (the pipeline degrades gracefully if these are empty).
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ── Model overrides (optional) ────────────────────────────────────────────────
# LiteLLM model strings. Order = fallback chain. Comma-separated.
# Defaults target the most generous free tiers as of mid-2026.
LLM_CHAIN=cerebras/gpt-oss-120b,groq/llama-3.1-8b-instant,gemini/gemini-2.5-flash,ollama/qwen2.5

# Max characters of article text sent to the LLM (protects tokens-per-day).
MAX_INPUT_CHARS=6000
# Cap on articles summarized per run (0 = no cap).
MAX_ARTICLES_PER_RUN=0

# ── Paths ─────────────────────────────────────────────────────────────────────
DB_PATH=news.db
SITE_DIR=site
SITE_TITLE=Daily Global-Macro Brief
